# ===== 服务 =====
PORT=3000
CORS_ORIGIN=*

# ===== 鉴权 =====
JWT_SECRET=tl-goal-contract-dev-secret-change-me
JWT_EXPIRES_IN=24h

# ===== 数据存储（相对 back/ 目录）=====
DB_FILE=data/goal-contract.db

# ===== AI 开关 =====
# false = 降级模式（不调 LLM，业务零影响）
AI_ENABLED=true

# ===== LLM 端点（OpenAI 兼容协议；演示用 DeepSeek 外网）=====
LLM_BASE_URL=https://api.deepseek.com
LLM_API_KEY=sk-your-key-here
# deepseek-v4-flash（服务端规范名 deepseek-flash，推理型模型）
LLM_MODEL=deepseek-v4-flash
# 单次调用总预算（毫秒）。推理型模型偏慢，建议 ≥ 30000
LLM_TIMEOUT_MS=30000
# 推理型模型需给足输出预算，否则 content 可能为空
LLM_MAX_TOKENS=4096
LLM_TEMPERATURE=0.3

# ===== 备用端点（可选）=====
LLM_BACKUP_BASE_URL=
LLM_BACKUP_API_KEY=
LLM_BACKUP_MODEL=