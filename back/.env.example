# ===== 服务 =====
# 服务端口（前端联调地址：http://localhost:3000/api）
PORT=3000
# 允许跨域来源，前端 Vite 默认 5173；* 表示不限制（演示用）
CORS_ORIGIN=*

# ===== 鉴权（AUTH-03：有效期 24h）=====
JWT_SECRET=tl-weekly-report-dev-secret-change-me
JWT_EXPIRES_IN=24h

# ===== 数据存储（相对 back/ 目录）=====
DB_FILE=data/weekly-report.db

# ===== AI 开关（GEN-07）=====
# false = 降级模式：不调 LLM，业务接口零影响
# 不配置 LLM_BASE_URL 时同样自动降级
AI_ENABLED=true

# ===== LLM 端点（OpenAI 兼容协议）=====
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=sk-your-key-here
LLM_MODEL=gpt-4o-mini
# 单次调用超时（毫秒），需求 GEN-04 规定上限 20 秒
LLM_TIMEOUT_MS=20000
# 采样温度（周报整理类任务建议低温）
LLM_TEMPERATURE=0.3
# 部分网关支持 response_format=json_object，默认关闭以兼容所有端点
LLM_JSON_MODE=false

# ===== 备用端点（可选，主端点失败时按顺序 fallback，见需求第十四章风险应对）=====
LLM_BACKUP_BASE_URL=
LLM_BACKUP_API_KEY=
LLM_BACKUP_MODEL=
