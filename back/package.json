{
  "name": "tl-weekly-report-backend",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "AI 智能周报系统 · 后端服务（Express + TypeScript + SQLite + JWT）",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "start": "node --env-file-if-exists=.env src/index.ts",
    "dev": "node --watch --env-file-if-exists=.env src/index.ts",
    "seed": "node --env-file-if-exists=.env src/scripts/seedCli.ts",
    "smoke": "node --env-file-if-exists=.env src/scripts/smoke.ts",
    "mock:llm": "node src/scripts/mockLlm.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "cors": "^2.8.6",
    "express": "^5.3.0",
    "jsonwebtoken": "^9.0.3"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^26.6.5",
    "typescript": "^7.0.2"
  }
}
