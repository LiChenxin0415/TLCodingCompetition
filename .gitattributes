# 统一换行符与文本处理，避免多智能体在不同平台产生 CRLF/LF 冲突噪音
* text=auto

*.md   text eol=lf
*.json text eol=lf
*.yml  text eol=lf
*.yaml text eol=lf
*.js   text eol=lf
*.ts   text eol=lf
*.java text eol=lf
*.py   text eol=lf
*.sql  text eol=lf
*.sh   text eol=lf

# 二进制文件不做转换
*.png  binary
*.jpg  binary
*.jpeg binary
*.gif  binary
*.ico  binary
*.pdf  binary
*.zip  binary
*.xlsx binary
*.docx binary
